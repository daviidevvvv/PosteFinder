rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPreferences() {
      let d = request.resource.data;
      return d.keys().hasOnly(['version', 'favorites', 'ratings', 'removedIds', 'customPlaces', 'updatedAt'])
        && d.keys().hasAll(['version', 'favorites', 'ratings', 'removedIds', 'customPlaces', 'updatedAt'])
        && d.version == 1
        && d.favorites is list && d.favorites.size() <= 150
        && d.removedIds is list && d.removedIds.size() <= 150
        && d.ratings is map && d.ratings.size() <= 150
        && d.customPlaces is list && d.customPlaces.size() <= 50
        && d.updatedAt is timestamp;
    }

    // A user's private addresses and preferences are visible ONLY to their own uid.
    match /users/{uid}/private/preferences {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validPreferences();
      allow delete: if isOwner(uid);
    }

    // Optional per-user Gemini key sync. WARNING: owner-readable Firestore storage
    // is not equivalent to a server-side secret vault or Netlify environment variable.
    // Never grant a public read or query for this document.
    function validGeminiKeyDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['version', 'apiKey', 'updatedAt'])
        && d.keys().hasAll(['version', 'apiKey', 'updatedAt'])
        && d.version == 1
        && d.apiKey is string
        && d.apiKey.size() >= 30 && d.apiKey.size() <= 160
        && d.apiKey.matches('^AIza[A-Za-z0-9_-]+
    // Writes must use the Firebase Admin SDK with trusted server credentials.
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Secure default: all other collections are inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && d.updatedAt is timestamp;
    }

    match /users/{uid}/private/geminiKey {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validGeminiKeyDoc();
      allow delete: if isOwner(uid);
    }

    // Public curated postal/locker directory. Readable by anyone; never client-editable.
    // Writes must use the Firebase Admin SDK with trusted server credentials.
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Secure default: all other collections are inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
